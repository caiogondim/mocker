{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "target": "ES2024",
    "pretty": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["esnext"],
    "types": ["node", "bun"],
    "noImplicitReturns": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*.ts", "./tools/**/*.ts"]
}
