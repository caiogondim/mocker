{
  "name": "mocker",
  "version": "1.2.0",
  "description": "HTTP mock server for development and stable E2E tests",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "ci": "biome check . && bun run type-check && bun test",
    "test:all": "bun run ci",
    "start": "bun --max-http-header-size=1000000 ./mocker",
    "dev:httpbin": "bun --watch ./mocker --mocksDir ./responses/httpbin --origin http://httpbin.org --logging verbose --mode read-write",
    "dev": "bun --watch --max-http-header-size=1000000 ./mocker",
    "test": "bun test",
    "type-check": "tsc --noEmit -p ./tsconfig.json",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "proxy:rust": "cd proxies/rust-proxy && cargo run",
    "proxy:swift": "cd proxies/swift-proxy && swift run"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": "./mocker"
}
